# Server port
PORT=3000

# MongoDB connection string.
# The game (bot mode) works WITHOUT MongoDB.
# Multiplayer + profiles/leaderboard need a running MongoDB.
# Leave it as-is or point it at your local/Atlas instance.
MONGODB_URI=mongodb://localhost:27017/card-clash

# Set to "false" to disable MongoDB completely (bot + local play still work).
USE_MONGODB=true
